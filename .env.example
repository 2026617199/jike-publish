# Jike API configuration
# Copy this file to .env and fill in your values

# API endpoint settings (obtain from the Jike app traffic)
JIKE_ENDPOINT_ID=jike
JIKE_ENDPOINT_URL=https://your-jike-endpoint-url/
JIKE_BUNDLE_ID=com.jike.app
JIKE_APP_VERSION=7.0.0
JIKE_BUILD_NO=700
JIKE_USER_AGENT=jike/7.0.0 (iPhone; iOS 16.0; Scale/3.00)

# Authentication (obtain by logging in via the Jike app)
JIKE_ACCESS_TOKEN=your-access-token-here
